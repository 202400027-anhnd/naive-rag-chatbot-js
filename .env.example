# ==============================================================================
# CẤU HÌNH LLM (LỰA CHỌN 1 TRONG CÁC NHÀ CUNG CẤP SAU)
# ==============================================================================

# --- LỰA CHỌN 1: GOOGLE GEMINI (KHUYẾN NGHỊ) ---
# Đăng ký và lấy API Key miễn phí tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
# Hoặc có thể đặt tên biến là GOOGLE_API_KEY
# GOOGLE_API_KEY=your_gemini_api_key

# Tên mô hình Gemini (Mặc định: gemini-1.5-flash)
# Các lựa chọn phổ biến: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
MODEL_NAME=gemini-1.5-flash

# --- LỰA CHỌN 2: LITELLM PROXY HOẶC OPENAI-COMPATIBLE GATEWAY ---
# LITELLM_API_KEY=your_litellm_api_key
# LITELLM_BASE_URL=https://your-litellm-proxy.com/v1
# MODEL_NAME=gpt-4o-mini

# --- LỰA CHỌN 3: OPENAI DIRECT ---
# OPENAI_API_KEY=your_openai_api_key
# MODEL_NAME=gpt-4o-mini

# ==============================================================================
# CẤU HÌNH TÌM KIẾM WEB PHÁP LUẬT (STAGE 3)
# ==============================================================================
# Đăng ký và lấy API Key tìm kiếm Tavily miễn phí tại: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key